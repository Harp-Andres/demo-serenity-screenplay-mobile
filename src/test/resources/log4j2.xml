<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="LOG_PATH">build/logs</Property>
  </Properties>
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss} [%highlight{%p}] %c{1} - %msg%n"/>
    </Console>

    <RollingFile name="AndroidFile" fileName="${LOG_PATH}/execution_android.log"
                 filePattern="${LOG_PATH}/android-%d{MM-dd-yy}-%i.log.gz">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5p %c{1} - %m%n"/>
      <Policies><SizeBasedTriggeringPolicy size="10MB"/></Policies>
    </RollingFile>

    <RollingFile name="IOSFile" fileName="${LOG_PATH}/execution_ios.log"
                 filePattern="${LOG_PATH}/ios-%d{MM-dd-yy}-%i.log.gz">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5p %c{1} - %m%n"/>
      <Policies><SizeBasedTriggeringPolicy size="10MB"/></Policies>
    </RollingFile>
  </Appenders>

  <Loggers>
    <Logger name="io.appium" level="INFO" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
